# Rust
/target/
**/*.rs.bk

# Python reference
__pycache__/
*.pyc

# Never commit real FileMaker files or recovered outputs.
*.fmp12
*_DECRYPTED*
!tests/fixtures/*.fmp12
# but not decrypt outputs/password files generated by demo runs
tests/fixtures/*_DECRYPTED*
tests/fixtures/*_password.txt

# Keep the curated default list; keep personal/large lists out.
wordlists/*
!wordlists/common.txt

# Agent worktrees
.claude/

# Local loose-ends tracker (not shipped)
.todo/
